# ============================================================
# СТАДИЯ 1: СБОРКА (build)
# Используем образ с JDK 21 и Gradle.
# Здесь происходит компиляция Kotlin-кода и скачивание зависимостей.
# ============================================================
FROM gradle:8-jdk21 AS build

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Сначала копируем только файлы сборки (build.gradle.kts, settings.gradle.kts).
# Это делается для кэширования: если зависимости не менялись,
# Docker не будет заново скачивать их при каждой сборке.
COPY build.gradle.kts settings.gradle.kts ./

# Скачиваем все зависимости Gradle.
# Этот слой закэшируется и будет переиспользован, пока не изменятся файлы сборки.
RUN gradle dependencies --no-daemon || true

# Теперь копируем весь исходный код проекта.
# Если изменился только код (а не зависимости), Docker пропустит предыдущий шаг.
COPY . .

# Собираем дистрибутив приложения.
# Плагин application создаст папку build/install/key-learning/
# с готовым к запуску приложением, всеми JAR-зависимостями и стартовым скриптом.
RUN gradle installDist --no-daemon

# ============================================================
# СТАДИЯ 2: ЗАПУСК (run)
# Используем лёгкий образ только с JRE (без JDK, без Gradle).
# Размер итогового образа будет ≈200 МБ вместо ≈1 ГБ.
# ============================================================
FROM eclipse-temurin:21-jre-alpine

# Метаданные образа (необязательно, но полезно для идентификации)
LABEL maintainer="jurikT.0@yandex.ru"
LABEL description="KeyLearning Backend - Kotlin/http4k"

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем собранный дистрибутив из стадии build.
# --from=build означает "взять из предыдущей стадии с именем build".
# Папка key-learning содержит: bin/ (стартовый скрипт), lib/ (все JAR-файлы).
COPY --from=build /app/build/install/key-learning /app

# Открываем порт 8228 (тот, на котором слушает http4k/Jetty).
# Это декларативная информация — Docker не блокирует другие порты,
# но это подсказка для docker-compose и пользователей образа.
EXPOSE 8228

# Команда запуска приложения.
# bin/key-learning — это стартовый скрипт, созданный плагином application.
# Он автоматически находит все JAR в lib/ и запускает главный класс.
# Мы передаём JVM флаги для оптимизации памяти (важно для VPS с 2 ГБ RAM):
#   -Xms256m - начальная куча 256 МБ
#   -Xmx512m - максимальная куча 512 МБ (не даём JVM съесть всю память)
ENTRYPOINT ["./bin/key-learning", "-J-Xms256m", "-J-Xmx512m"]