# ============================================================
# DOCKERFILE ДЛЯ FRONTEND (Node.js)
# ============================================================
# Используем лёгкий образ Node.js 20 на базе Alpine Linux.
# Alpine — минимальный дистрибутив Linux (≈5 МБ), что делает
# итоговый образ компактным (≈150 МБ вместо ≈1 ГБ для Ubuntu).
# ============================================================
FROM node:20-alpine

# Метаданные образа (необязательно, но полезно для идентификации)
LABEL maintainer="jurikT.0@yandex.ru"
LABEL description="KeyLearning Frontend - Node.js static server"

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Сначала копируем только файлы package.json и package-lock.json.
# Это делается для кэширования зависимостей:
# если зависимости не менялись, Docker не будет заново запускать npm ci.
COPY package.json package-lock.json ./

# Устанавливаем зависимости.
# Используем npm ci (не npm install) — он строже:
#   - Читает package-lock.json и устанавливает ТОЧНЫЕ версии
#   - Удаляет node_modules перед установкой (чистая установка)
#   - Быстрее и воспроизводимее, чем npm install
# Флаг --only=production исключает devDependencies (jest и т.д.),
# так как на проде тесты не нужны.
RUN npm ci --only=production

# Теперь копируем весь остальной код фронтенда.
# Если изменился только код (а не package.json),
# Docker пропустит предыдущий шаг с npm ci (возьмёт из кэша).
COPY . .

# Открываем порт 3000 (тот, на котором слушает server.js).
# Это декларативная информация для docker-compose и пользователей образа.
EXPOSE 3000

# Команда запуска приложения.
# Используем массив (exec form), а не строку (shell form).
# Это важно: массив позволяет Docker корректно передавать сигналы
# (например, SIGTERM при остановке контейнера) напрямую в Node.js процесс.
# Если бы мы написали CMD "node server.js" (строкой), Docker запустил бы
# оболочку sh, которая не передаёт сигналы, и контейнер останавливался бы
# принудительно через 10 секунд.
CMD ["node", "server.js"]